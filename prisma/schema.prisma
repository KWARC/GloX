// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  CURATOR
  EXTRACTOR
}

enum DocumentStatus {
  UPLOADED
  TEXT_EXTRACTED
  FAILED
}

enum FloDownBlockStatus {
  DISCARDED
  EXTRACTED
  FINALIZED_IN_FILE
  SUBMITTED_TO_MATHHUB
}

enum IndexStatus {
  EXTRACTED
  FINALIZED
  SUBMITTED_TO_MATHHUB
}

model User {
  id            String   @id @default(uuid())
  firstName     String?
  lastName      String?
  email         String   @unique
  passwordHash  String?
  emailVerified Boolean  @default(false)
  role          UserRole @default(EXTRACTOR)

  createdAt              DateTime              @default(now())
  documents              Document[]
  floDownBlockVersions   FloDownBlockVersion[]
  createdFloDownBlocks   FloDownBlock[]        @relation("FloDownBlockCreatedBy")
  updatedFloDownBlocks   FloDownBlock[]        @relation("FloDownBlockUpdatedBy")
  createdMarkReferences  MarkReference[]       @relation("MarkReferenceCreatedBy")
  confirmedSymbols       Symbol[]
  createdModuleDescriptions ModuleDescription[] @relation("ModuleDescriptionCreatedBy")
}

model ModuleDescription {
  id       String @id @default(uuid())
  moduleId String @unique

  titleStatement     Json
  inhaltStatement    Json
  lernzieleStatement Json

  futureRepo      String @default("courses/FAU/module-descriptions")
  modulesFilePath String @default("modules")
  defsFilePath    String @default("defs")
  language        String @default("de")

  createdById String
  createdBy   User   @relation("ModuleDescriptionCreatedBy", fields: [createdById], references: [id])

  indexStatus IndexStatus @default(EXTRACTED)

  floDownBlocks FloDownBlock[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
  @@index([indexStatus])
}

model Document {
  id       String @id @default(uuid())
  filename String
  fileHash String
  mimeType String
  fileSize Int

  futureRepo String @default("smglom/softeng")
  filePath   String @default("mod")
  language   String @default("en")

  indexStatus IndexStatus?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  status         DocumentStatus  @default(UPLOADED)
  pages          DocumentPage[]
  floDownBlocks  FloDownBlock[]
  markReferences MarkReference[]
  latexTables    LatexTable[]
  llmSuggestion  LlmSuggestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fileHash, userId])
  @@index([indexStatus])

  /// @deprecated No longer used by application. Retained for existing data.
  moduleDescription Boolean @default(false)

  @@index([moduleDescription])
}

model DocumentPage {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  pageNumber Int
  text       String @db.Text

  floDownBlocks          FloDownBlock[]
  markReferences         MarkReference[]
  llmSuggestedDefinition LlmSuggestedDefinition[]

  createdAt DateTime @default(now())

  @@unique([documentId, pageNumber])
  @@index([documentId])
}

model Symbol {
  id         String  @id @default(uuid())
  symbolName String
  alias      String?

  futureRepo String
  filePath   String
  fileName   String
  language   String @default("en")

  hasConfirmed  Boolean @default(false)
  confirmedById String?
  confirmedBy   User?   @relation(fields: [confirmedById], references: [id])

  /// @deprecated Legacy SymbolicReference rows only — not used by application code.
  symbolicReferences SymbolicReference[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([symbolName, futureRepo, filePath, fileName, language])
  @@index([symbolName])
  @@index([confirmedById])
}

/// Curated FloDown block — provenance + FTML `statement` JSON (`definition` or `paragraph`).
/// Block shape is determined by `statement.type`, not a separate DB column.
model FloDownBlock {
  id String @id @default(uuid())

  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  documentPageId String?
  documentPage   DocumentPage? @relation(fields: [documentPageId], references: [id], onDelete: Cascade)

  moduleDescriptionId String?
  moduleDescription   ModuleDescription? @relation(fields: [moduleDescriptionId], references: [id], onDelete: Cascade)

  pageNumber Int?

  originalText String @db.Text
  statement    Json

  /// Local symbol names this row introduces via addSymbolDeclaration at export.
  declaredSymbols String[] @default([])

  status          FloDownBlockStatus @default(EXTRACTED)
  discardedReason String?

  futureRepo String @default("smglom/Glox")
  filePath   String @default("mod")
  fileName   String @default("Glox")
  language   String @default("en")

  createdById String
  createdBy   User   @relation("FloDownBlockCreatedBy", fields: [createdById], references: [id])

  updatedById String?
  updatedBy   User?  @relation("FloDownBlockUpdatedBy", fields: [updatedById], references: [id])

  currentVersion Int                   @default(1)
  versionHistory FloDownBlockVersion[]

  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  llmSuggestedDefiniendas LlmSuggestedDefinienda[]

  /// @deprecated Legacy join rows only — application does not read or write these.
  definitionSymbolicRefs DefinitionSymbolicRef[]

  @@index([documentPageId])
  @@index([documentId])
  @@index([moduleDescriptionId])
  @@index([futureRepo, filePath, fileName, language])
}

model MarkReference {
  id String @id @default(uuid())

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  documentPageId String
  documentPage   DocumentPage @relation(fields: [documentPageId], references: [id], onDelete: Cascade)

  pageNumber Int

  symbolName    String
  verbalization String?

  createdById String
  createdBy   User   @relation("MarkReferenceCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([documentId])
  @@index([documentPageId])
  @@map("markReference")
}

model LatexTable {
  id String @id @default(uuid())

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  futureRepo String
  filePath   String
  fileName   String
  language   String

  finalLatex String  @db.Text
  history    Json    @db.JsonB
  isFinal    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([documentId, futureRepo, filePath, fileName, language])
}

model FloDownBlockVersion {
  id String @id @default(uuid())

  floDownBlockId String
  floDownBlock   FloDownBlock @relation(fields: [floDownBlockId], references: [id], onDelete: Cascade)

  versionNumber Int

  originalText String @db.Text
  statement    Json

  editedById String
  editedBy   User   @relation(fields: [editedById], references: [id])

  createdAt DateTime @default(now())

  @@unique([floDownBlockId, versionNumber])
  @@index([floDownBlockId])
}

model LlmSuggestion {
  id String @id @default(uuid())

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  customPrompt String   @db.Text
  createdAt    DateTime @default(now())

  pages LlmSuggestedDefinition[]

  @@index([documentId])
}

model LlmSuggestedDefinition {
  id String @id @default(uuid())

  llmSuggestionId String
  llmSuggestion   LlmSuggestion @relation(fields: [llmSuggestionId], references: [id], onDelete: Cascade)

  documentPageId String
  documentPage   DocumentPage @relation(fields: [documentPageId], references: [id], onDelete: Cascade)
  pageNumber     Int

  suggestions    Json
  definitionText String? @db.Text

  createdAt DateTime @default(now())

  @@unique([llmSuggestionId, documentPageId])
  @@index([documentPageId])
}

model LlmSuggestedDefinienda {
  id String @id @default(uuid())

  definienda String[]

  floDownBlockId String
  floDownBlock   FloDownBlock @relation(fields: [floDownBlockId], references: [id], onDelete: Cascade)

  prompt String? @db.Text

  createdAt DateTime @default(now())

  @@index([floDownBlockId])
}

// -----------------------------------------------------------------------------
// Deprecated — retained for existing data; not used by application code.
// -----------------------------------------------------------------------------

enum SymbolicRefSource {
  MATHHUB
  DEFINIENDUM
}

/// @deprecated Unused by application. Retained for existing data.
model SymbolicReference {
  id         String @id @default(uuid())
  name       String
  conceptUri String
  archive    String
  filePath   String
  fileName   String
  language   String @default("en")

  definiendumId String?
  definiendum   Symbol? @relation(fields: [definiendumId], references: [id], onDelete: Cascade)

  definitionSymbolicRefs DefinitionSymbolicRef[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([definiendumId])
  @@index([archive, filePath, fileName, conceptUri, language])
}

/// @deprecated Unused by application. Retained for existing data.
model DefinitionSymbolicRef {
  id String @id @default(uuid())

  floDownBlockId String
  floDownBlock   FloDownBlock @relation(fields: [floDownBlockId], references: [id], onDelete: Cascade)

  symbolicReferenceId String
  symbolicReference   SymbolicReference @relation(fields: [symbolicReferenceId], references: [id], onDelete: Cascade)

  source SymbolicRefSource

  createdAt DateTime @default(now())

  @@unique([floDownBlockId, symbolicReferenceId])
  @@index([floDownBlockId])
  @@index([symbolicReferenceId])
}
